using DistributedBms.Configuration;
using DistributedBms.Drivers;

namespace DistributedBms.Polling;

public class PollingService
{
    private readonly ConfigurationLoader _configurationLoader;
    private readonly DriverFactory _driverFactory;

    public PollingService(
        ConfigurationLoader configurationLoader,
        DriverFactory driverFactory)
    {
        _configurationLoader = configurationLoader;
        _driverFactory = driverFactory;
    }

    public async Task RunAsync(
        string interfaceName,
        CancellationToken cancellationToken)
    {
        var config = _configurationLoader.GetInterface(interfaceName);

        var name = config["name"]?.ToString()
            ?? throw new InvalidOperationException(
                $"Interface '{interfaceName}' is missing 'name'"
            );

        var driverName = config["driver"]?.ToString()
            ?? throw new InvalidOperationException(
                $"Interface '{interfaceName}' is missing 'driver'"
            );

        var scanIntervalMs = Convert.ToInt32(
            config["scan-interval-ms"]
        );

        var driver = _driverFactory.Create(
            driverName,
            config
        );

        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                var values = await driver.ReadAsync();

                Console.WriteLine(
                    $"[{name}] {values}"
                );
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"[{name}] Polling error: {ex.Message}"
                );
            }

            await Task.Delay(
                scanIntervalMs,
                cancellationToken
            );
        }
    }
}